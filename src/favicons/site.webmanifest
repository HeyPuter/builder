{
  "id": "/",
  "name": "AI Builder by Puter",
  "short_name": "AI Builder",
  "description": "Build apps, websites, and tools with AI — no code required. Describe what you want and Puter's AI builder creates it in your browser.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "background_color": "#171c24",
  "theme_color": "#171c24",
  "categories": ["productivity", "developer", "utilities"],
  "icons": [
    {
      "src": "/favicons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/desktop-light.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Describe your idea and AI Builder creates the app or website — no code required"
    },
    {
      "src": "/screenshots/desktop-dark.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "AI Builder in dark mode"
    },
    {
      "src": "/screenshots/mobile-light.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Build apps and websites with AI from your phone"
    },
    {
      "src": "/screenshots/mobile-dark.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "AI Builder on mobile in dark mode"
    }
  ]
}
